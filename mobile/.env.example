# ==============================================================================
# RideSafe AI — Mobile (Expo / React Native) Environment Configuration Example
# ==============================================================================
# The Android / iOS mobile application is NOT deployed on Vercel.
# Configure this variable before building standalone mobile binaries (.apk, EAS build).

# Production Backend API URL:
# Replace with your deployed Vercel domain:
EXPO_PUBLIC_API_URL=https://your-production-domain.vercel.app/api

# Local Development Fallbacks:
# - Android Emulator uses: http://10.0.2.2:5000/api
# - Physical Android Phone on Wi-Fi: http://192.168.x.x:5000/api
# - iOS Simulator uses: http://localhost:5000/api

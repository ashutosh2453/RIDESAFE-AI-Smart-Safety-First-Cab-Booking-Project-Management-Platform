# ==============================================================================
# RideSafe AI — Web Frontend Environment Configuration Example
# ==============================================================================
# For Vercel Production Deployments (where Web and Backend share the same domain):
# Leave VITE_API_URL set to /api so requests route through Vercel's rewrite rules:
VITE_API_URL=/api

# For Standalone Local Development:
# Uncomment the line below to connect directly to the local Express backend on port 5000:
# VITE_API_URL=http://localhost:5000/api

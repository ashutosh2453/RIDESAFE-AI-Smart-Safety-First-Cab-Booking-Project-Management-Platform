# ==============================================================================
# RideSafe AI — Backend Environment Configuration Example
# ==============================================================================
# Configure these variables in your local .env or in Vercel Project Settings (Backend Service).
# DO NOT commit production secrets to version control.

# Server Port (Development default: 5000. In Vercel, PORT is managed automatically)
PORT=5000

# Runtime Environment ('development' | 'production' | 'test')
NODE_ENV=development

# PostgreSQL Connection String (Remote URL required for Vercel, e.g. Neon, Supabase, AWS RDS)
# Development Example: postgresql://postgres:password@localhost:5432/ridesafe_ai?schema=public
# Production Example:  postgresql://user:password@ep-cool-pool.us-east-1.aws.neon.tech/ridesafe_ai?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/ridesafe_ai?schema=public"

# Cryptographically Secure Secret for signing JWT authentication tokens (Min 32 characters)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace_with_a_secure_random_jwt_secret_min_32_chars"

# Token Expiration Duration (e.g. '7d', '24h')
JWT_EXPIRES_IN="7d"

# Allowed Cross-Origin Origins (Comma-separated URLs)
# In development: http://localhost:5173,http://localhost:3000
# In production on Vercel: https://your-production-domain.vercel.app
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Local Storage Directory for Pickup Surroundings Photos (In Vercel serverless, uses /tmp/uploads)
UPLOAD_DIR="./uploads"

# Optional External AI API Key (OpenAI / LLM API key for RideSafe AI Assistant)
# If empty, RideSafe AI automatically falls back to its built-in knowledge retrieval engine.
AI_API_KEY=""
